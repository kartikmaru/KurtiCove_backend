# ─── Server ─────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── MongoDB Atlas ───────────────────────────────────────────────────
# Full Atlas connection string — get it from Atlas › Connect › Drivers
# Supports both variable names for backward compatibility
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# (legacy alias — MONGODB_URI is preferred, but MONGODB_URL also works)
# MONGODB_URL=

# ─── JWT ─────────────────────────────────────────────────────────────
SECRET_KEY=replace_with_a_long_random_string_at_least_32_chars

# ─── CORS — set to your Vercel frontend domain ───────────────────────
CLIENT_URL=https://your-project.vercel.app

# ─── Cloudinary (image uploads) ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email / SMTP (OTP mails) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password

# ─── Encryption ──────────────────────────────────────────────────────
CRYPTR_SECRET=replace_with_a_random_secret_string

# ─── Frontend URL (used in email links if needed) ────────────────────
FRONTEND_URL=https://your-project.vercel.app
